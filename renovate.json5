{
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
  ],
  "packageRules": [
    {
      "description": "Look up Vanniktech releases by implementation coordinates: Renovate skips Gradle plugin markers on Maven Central",
      "matchManagers": ["gradle"],
      "matchDatasources": ["maven"],
      "matchDepNames": ["com.vanniktech.maven.publish"],
      "overridePackageName": "com.vanniktech:gradle-maven-publish-plugin",
      "registryUrls": ["https://repo.maven.apache.org/maven2"]
    },
    {
      "matchPackageNames": ["connectbot/*", "kruton/*"],
      "minimumReleaseAge": null
    },
    {
      "matchManagers": ["gradle"],
      "groupName": "Kotlin and Gradle dependencies",
    },
  ],
}
